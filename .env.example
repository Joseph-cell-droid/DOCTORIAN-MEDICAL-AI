# Doctorian Medical AI - Environment Configuration
APP_URL=http://localhost:3000
PORT=3000
JWT_SECRET=your_jwt_secret_here

# Security & Data Encryption
ENCRYPTION_KEY=
VITE_ENCRYPTION_KEY=

# Hugging Face Inference Router (OpenAI-compatible)
# Endpoint: https://router.huggingface.co/v1/chat/completions
HF_TOKEN=
VITE_HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-BF16:deepinfra

# Google Gemini API
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# AI Provider Routing (huggingface | gemini | local)
ACTIVE_AI_PROVIDER=huggingface
USE_LOCAL_AI=false

# Ollama / LM Studio Local AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-3-4b

# Optional Cloud Backups
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
TOGETHER_URL=https://api.together.xyz/v1/chat/completions
TOGETHER_MODEL=mistralai/mistral-7b-instruct

# SMS Gateways (Uganda)
MTN_API_KEY=
AIRTEL_API_KEY=
SENDER_ID=DOCTORIAN_MED
DOCTOR_PHONE_NUMBER=
MENTOR_PHONE_NUMBER=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# OAuth Configurations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=