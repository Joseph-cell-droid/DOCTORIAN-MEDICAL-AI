APP_URL="http://localhost:3000"
JWT_SECRET=doctorian_super_secret_key
 
# ── AI Provider ─────────────────────────────────────────────
# "ollama" = use your local Ollama (recommended)
# "gemini"  = use cloud models via OpenRouter
ACTIVE_AI_PROVIDER=ollama
 
# ── Ollama / LM Studio Settings ──────────────────────────────
USE_LOCAL_AI=true
OLLAMA_URL=http://localhost:11434
LOCAL_AI_URL=http://localhost:11434/api/generate

# For LM Studio on your PC (OpenAI-compatible local server)
# Use http://localhost:1234 or use a secure tunnel (ngrok) in production
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=gemma-2-9b-it
 
# Change this to whatever model you have pulled in Ollama.
# Common choices: llama3.1, llama3, phi3:mini, mistral, gemma2
OLLAMA_MODEL=llama3.1
 
# Set to "true" to suppress Ollama errors and silently fall
# back to cloud models if Ollama is unreachable.
SILENT_OLLAMA=false
 
# ── Cloud Fallback (optional) ────────────────────────────────
# Leave blank to run fully offline with Ollama only.
OPENROUTER_API_KEY=

# ── Together AI Core Brain (Priority Online Cloud) ───────────
TOGETHER_API_KEY=
TOGETHER_URL=https://api.together.xyz/v1/chat/completions
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
 
# ── Other Services (leave blank if not needed) ───────────────
MTN_API_KEY=
AIRTEL_API_KEY=
SENDER_ID=DOCTORIAN_MED
DOCTOR_PHONE_NUMBER=
MENTOR_PHONE_NUMBER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=