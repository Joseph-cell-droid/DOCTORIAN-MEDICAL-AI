{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doctorian Medical AI",
  "version": "2.5.0",
  "identifier": "ai.doctorian.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Doctorian Medical AI - Autonomous Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: ws: wss: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Doctorian AI Health Systems Ltd.",
    "copyright": "Copyright © 2026 Doctorian AI Team. All rights reserved.",
    "category": "Medical",
    "shortDescription": "Autonomous AI Medical Workstation with Offline Ollama LLM, SQLite RAG Knowledge Base, and Sensor Integration.",
    "longDescription": "Doctorian Medical AI is a professional local-first clinical intelligence desktop workstation designed for medical practitioners, clinical researchers, and patient diagnostic support. Equipped with local Ollama inference, SQLite medical RAG database, and real-time vital sensor telemetry.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "displayInstallerProgress": true,
        "shortcutName": "Doctorian Medical AI",
        "createDesktopShortcut": "always",
        "createStartMenuShortcut": true,
        "allowToChangeInstallationDirectory": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGF1dG9tYXRpYyB1cGRhdGVyIGtleSBmb3IgRG9jdG9yaWFuIE1lZGljYWwgQUkK",
      "endpoints": [
        "https://raw.githubusercontent.com/doctorian-ai/doctorian/main/releases/latest.json",
        "https://github.com/doctorian-ai/doctorian/releases/latest/download/latest.json"
      ]
    }
  }
}
